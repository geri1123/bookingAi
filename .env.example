# =============================================================================
# BookingAI — environment variables
#
# Copy this file to `.env` for local docker-compose use:
#   cp .env.example .env
#
# In production these are NOT read from a committed .env file — they're
# injected as real secrets on each server / in GitHub Actions. See
# DEPLOYMENT.md for how each server's .env is generated and kept in sync.
# =============================================================================

# --------------------------------------------------------------------------
# Postgres (shared dev instance — docker/postgres-init creates one DB per
# service: core_service, ai_service, billing_service, communication_service)
# --------------------------------------------------------------------------
POSTGRES_USER=bookingai
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=bookingai

# --------------------------------------------------------------------------
# Shared secrets — used by more than one service, must be IDENTICAL across
# every service that references them (that's how they trust each other).
# --------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-32-chars-minimum-please
JWT_REFRESH_SECRET=change-me-different-32-chars-minimum
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DEFAULT=4h
JWT_REFRESH_TTL_REMEMBER_ME=2d

# Shared secret core/ai/billing/communication use to authenticate
# service-to-service calls to each other.
INTERNAL_API_KEY=change-me-internal-service-key

# Used by communication-service to encrypt stored channel tokens (WhatsApp/
# Messenger access tokens etc). Must stay stable — rotating it invalidates
# every stored token.
CHANNEL_TOKEN_ENCRYPTION_KEY=change-me-32-bytes-encryption-key

CLIENT_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --------------------------------------------------------------------------
# api-gateway
# --------------------------------------------------------------------------
GATEWAY_PORT=8000
CORE_SERVICE_URL=http://core-service:8080
AI_SERVICE_URL=http://ai-service:8081
COMMUNICATION_SERVICE_URL=http://communication-service:8082
GATEWAY_REDIS_URL=redis://redis:6379
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# --------------------------------------------------------------------------
# core-service
# --------------------------------------------------------------------------
CORE_PORT=8080
CORE_DATABASE_URL=postgresql://bookingai:change-me-locally@postgres:5432/core_service
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=10000
OUTBOX_TX_MAX_WAIT_MS=5000
OUTBOX_TX_TIMEOUT_MS=10000
CLOUDINARY_URL=cloudinary://key:secret@cloud-name
CORE_KAFKA_BROKERS=kafka:29092

# --------------------------------------------------------------------------
# ai-service
# --------------------------------------------------------------------------
AI_PORT=8081
AI_DATABASE_URL=postgresql://bookingai:change-me-locally@postgres:5432/ai_service
AI_REDIS_URL=redis://redis:6379
AI_KAFKA_BROKER=kafka:29092
BILLING_SERVICE_URL=http://billing-service:8083
ANTHROPIC_API_KEY=sk-ant-changeme
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=changeme
GEMINI_MODEL=gemini-2.0-flash
DEFAULT_AI_LANGUAGE=sq
AI_MAX_CONTEXT_MESSAGES=20
BUSINESS_INFO_CACHE_TTL_MS=60000
AI_MOCK_MODE=false

# --------------------------------------------------------------------------
# billing-service
# --------------------------------------------------------------------------
BILLING_PORT=8083
BILLING_DATABASE_URL=postgresql://bookingai:change-me-locally@postgres:5432/billing_service
BILLING_KAFKA_BROKER=kafka:29092

# --------------------------------------------------------------------------
# communication-service
# --------------------------------------------------------------------------
COMMUNICATION_PORT=8082
COMMUNICATION_DATABASE_URL=postgresql://bookingai:change-me-locally@postgres:5432/communication_service
COMMUNICATION_REDIS_URL=redis://redis:6379
COMMUNICATION_KAFKA_BROKERS=kafka:29092
META_APP_ID=changeme
META_APP_SECRET=changeme
META_GRAPH_API_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=changeme

# --------------------------------------------------------------------------
# notification-service
# --------------------------------------------------------------------------
NOTIFICATION_PORT=8084
NOTIFICATION_KAFKA_BROKERS=kafka:29092
NOTIFICATION_REDIS_URL=redis://redis:6379
RESEND_API_KEY=re_changeme
RESEND_FROM_EMAIL=no-reply@yourapp.com
