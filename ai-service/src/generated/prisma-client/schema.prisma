generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
}

enum CommunicationChannel {
  WHATSAPP
  VOICE
}

enum ConversationStatus {
  ACTIVE
  AWAITING_CONFIRMATION
  CLOSED
}

enum BookingIntentStatus {
  COLLECTING
  CONFIRMED
  FAILED
}

model AiSettings {
  id           String   @id @default(uuid())
  businessId   String   @unique @map("business_id")
  systemPrompt String?  @map("system_prompt")
  language     String?
  isEnabled    Boolean  @default(true) @map("is_enabled")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("ai_settings")
}

model Conversation {
  id            String               @id @default(uuid())
  businessId    String               @map("business_id")
  customerPhone String               @map("customer_phone")
  channel       CommunicationChannel
  status        ConversationStatus   @default(ACTIVE)
  messages      Json                 @default("[]")
  handedOff     Boolean              @default(false) @map("handed_off")
  lastMessageAt DateTime             @default(now()) @map("last_message_at")
  createdAt     DateTime             @default(now()) @map("created_at")

  bookingIntents BookingIntent[]

  @@unique([businessId, customerPhone])
  @@index([businessId])
  @@index([customerPhone])
  @@index([lastMessageAt])
  @@map("conversations")
}

model BookingIntent {
  id             String              @id @default(uuid())
  conversationId String              @map("conversation_id")
  businessId     String              @map("business_id")
  status         BookingIntentStatus @default(COLLECTING)
  payload        Json                @default("{}")
  reservationId  String?             @unique @map("reservation_id")
  failureReason  String?             @map("failure_reason")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@index([businessId])
  @@map("booking_intents")
}
